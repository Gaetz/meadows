#version 460 core

// Adaptive stylized ramp (dev design 2026-07-11) — measure the merged
// cascade 0's irradiance range so gi.glsl can posterize in log-stops
// anchored on the SCENE's actual contrast: a forest's subtle green
// bounce spreads across the bands, a torch in the night keeps its full
// range, no fixed thresholds. One workgroup, strided samples, temporal
// inertia in a tiny SSBO (never read back — the auto-exposure pattern).

layout(std140, binding = 2) uniform RcUbo {
    vec4 uRcClipInfo[2];
    vec4 uRcTileInfo; // w = clip/probe resolution
    vec4 uRcMisc;
    vec4 uRcLightPosRadius[16];
    vec4 uRcLightColor[16];
    vec4 uRcMisc2; // x = band count, y = contrast floor (log2 stops),
                   // z = adapt speed, w = dim-band level (0..1, the
                   //     depth of the below-mean pool)
};

layout(binding = 10) uniform sampler3D uRcCascade0; // merged, dir-major

// x = adapted log2 mean, y = adapted half-window (log2 stops),
// z = band count (passed through for gi.glsl), w = 1 once initialized.
layout(std430, binding = 12) buffer RcStatsBuf { vec4 uRcStats; };

layout(local_size_x = 64) in;

shared float sSumLog[64];
shared float sMax[64];

void main() {
    const int res = int(uRcTileInfo.w);
    const uint tid = gl_LocalInvocationID.x;

    // 512 strided probes (8 per thread), 8 direction slabs each.
    float sumLog = 0.0;
    float maxLum = 0.0;
    for (uint s = 0; s < 8; ++s) {
        const uint index = tid * 8u + s; // 0..511 -> 8x8x8 lattice
        const ivec3 cell = ivec3(index % 8u, (index / 8u) % 8u,
                                 index / 64u);
        const ivec3 probe = (cell * res + res / 2) / 8; // centered stride
        vec3 irradiance = vec3(0.0);
        for (int d = 0; d < 8; ++d) {
            irradiance += texelFetch(
                uRcCascade0, ivec3(probe.xy, d * res + probe.z), 0).rgb;
        }
        const float lum =
            dot(irradiance / 8.0, vec3(0.299, 0.587, 0.114));
        sumLog += log2(max(lum, 1e-5));
        maxLum = max(maxLum, lum);
    }
    sSumLog[tid] = sumLog;
    sMax[tid] = maxLum;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            sSumLog[tid] += sSumLog[tid + stride];
            sMax[tid] = max(sMax[tid], sMax[tid + stride]);
        }
        barrier();
    }
    if (tid != 0u) {
        return;
    }

    const float logMean = sSumLog[0] / 512.0;
    const float window =
        max(log2(max(sMax[0], 1e-5)) - logMean, uRcMisc2.y);
    const float speed = uRcMisc2.z;
    vec2 adapted = vec2(logMean, window);
    if (uRcStats.w > 0.5) {
        adapted = mix(uRcStats.xy, adapted, speed); // inertia
    }
    // z packs bands (integer part) + dim-band level (fraction) for
    // gi.glsl, which only sees this SSBO.
    uRcStats = vec4(adapted,
                    uRcMisc2.x + clamp(uRcMisc2.w, 0.05, 0.95), 1.0);
}
