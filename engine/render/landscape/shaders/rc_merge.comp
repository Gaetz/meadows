#version 460 core
#include "compat.glsl"
#include "common.glsl"
#include "rc_common.glsl"

// Radiance cascades MERGE: cascade i absorbs cascade i+1 so that
// after the full chain (top → 0) every texel of cascade 0 holds FULL
// radiance [0, ∞) for its direction. Per dst texel:
//   parent probes  = the 4 surrounding probes of cascade i+1 (manual
//                    bilinear — cascades interpolate linearly by
//                    construction, the paper's key property);
//   parent dirs    = the 2×2 children of this texel's direction
//                    (octahedral grid doubling), averaged;
//   L := L + β · L_parent,  β := β · β_parent.
// The TOP cascade instead merges the far-field SKY (rcSkyRadiance) —
// that is what makes canopy/valley openings light directionally.
// One dispatch per level, top to 0, memoryBarrier between (dst of step
// k is src of step k+1).

layout(std140, binding = 2) uniform RcUbo {
    vec4 uRcClipInfo[2];
    vec4 uRcTileInfo;
    vec4 uRcMisc;
    vec4 uRcLightPosRadius[16];
    vec4 uRcLightColor[16];
};

MEADOWS_PUSH_CONSTANTS(RcCascadeUbo) {
    vec4 uRcCascade;  // x = DST cascade index, y = dst probes/axis,
                      // z = dst dir grid W, w = dst dir grid H
    vec4 uRcCascadeB; // x = interval0, y = sky merge flag (top level),
                      // z = dst probe spacing, w = dst dir-major flag
    vec4 uRcCascadeC; // yzw = dst->src lattice offset in parent-probe
                      // units (per-cascade origins)
};

layout(binding = 0, rgba16f) uniform image3D uRcDst; // read_write
layout(binding = 7) uniform sampler3D uRcSrc;        // cascade i+1 (tiled)

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Fetch one texel of the SOURCE cascade (i+1, always dir-tiled: the
// dir-major layout only exists on cascade 0, never a merge source).
vec4 srcTexel(ivec3 probe, ivec2 dir, int srcProbes) {
    ivec3 texel = ivec3(dir.x * srcProbes + probe.x,
                        dir.y * srcProbes + probe.y, probe.z);
    return texelFetch(uRcSrc, texel, 0);
}

void main() {
    const int probes = int(uRcCascade.y);
    const ivec2 dirGrid = ivec2(uRcCascade.z, uRcCascade.w);
    const bool dirMajor = uRcCascadeB.w > 0.5;
    const bool skyMerge = uRcCascadeB.y > 0.5;

    ivec3 texel = ivec3(gl_GlobalInvocationID);
    ivec3 probe;
    ivec2 dir;
    if (dirMajor) {
        if (texel.x >= probes || texel.y >= probes ||
            texel.z >= probes * dirGrid.x * dirGrid.y) {
            return;
        }
        probe = ivec3(texel.x, texel.y, texel.z % probes);
        int dirIndex = texel.z / probes;
        dir = ivec2(dirIndex % dirGrid.x, dirIndex / dirGrid.x);
    } else {
        if (texel.x >= probes * dirGrid.x || texel.y >= probes * dirGrid.y ||
            texel.z >= probes) {
            return;
        }
        probe = ivec3(texel.x % probes, texel.y % probes, texel.z);
        dir = ivec2(texel.x / probes, texel.y / probes);
    }

    vec4 self = imageLoad(uRcDst, texel);
    if (self.a < 0.005) {
        return; // interval fully opaque: nothing behind it contributes
    }

    vec3 farRadiance;
    if (skyMerge) {
        farRadiance = rcSkyRadiance(rcOctDecode(vec2(dir), vec2(dirGrid)));
    } else {
        // Parent probes: cascade i+1 has HALF the probes per axis over
        // the same span — dst probe p sits at parent-space coordinate
        // (p + 0.5)/2 - 0.5 PLUS the dst->src lattice offset (the two
        // cascades carry their own world-snapped origins); trilinear
        // over the 2x2x2 surrounding parents (the paper's property).
        const int srcProbes = max(probes / 2, 1);
        vec3 parentCoord =
            (vec3(probe) + 0.5) * 0.5 - 0.5 + uRcCascadeC.yzw;
        ivec3 base = ivec3(floor(parentCoord));
        vec3 f = parentCoord - vec3(base);

        // Parent directions: the 2×2 children of `dir` in the doubled
        // octahedral grid, averaged (pre-filtering the angular domain).
        vec4 sum = vec4(0.0);
        for (int oz = 0; oz < 2; ++oz)
        for (int oy = 0; oy < 2; ++oy)
        for (int ox = 0; ox < 2; ++ox) {
            ivec3 p = clamp(base + ivec3(ox, oy, oz), ivec3(0),
                            ivec3(srcProbes - 1));
            float w = (ox == 1 ? f.x : 1.0 - f.x) *
                      (oy == 1 ? f.y : 1.0 - f.y) *
                      (oz == 1 ? f.z : 1.0 - f.z);
            vec4 dirSum = vec4(0.0);
            for (int dy = 0; dy < 2; ++dy)
            for (int dx = 0; dx < 2; ++dx) {
                dirSum += srcTexel(p, dir * 2 + ivec2(dx, dy), srcProbes);
            }
            sum += w * (dirSum * 0.25);
        }
        // COVERAGE fade (per-cascade origins): the parent lattice can
        // fall short of the dst lattice by up to half its spacing —
        // outside it the gather above freezes at the border texel, a
        // C1 break that read as ground BANDS at sunset. Fade toward the
        // far-field SKY (the top level's own fallback) across the last
        // parent probe instead.
        vec3 inside = min(parentCoord,
                          vec3(float(srcProbes) - 1.0) - parentCoord);
        float cov = clamp(min(inside.x, min(inside.y, inside.z)) + 1.0,
                          0.0, 1.0);
        farRadiance =
            mix(rcSkyRadiance(rcOctDecode(vec2(dir), vec2(dirGrid))),
                sum.rgb, cov);
    }

    imageStore(uRcDst, texel,
               vec4(self.rgb + self.a * farRadiance, self.a));
}
