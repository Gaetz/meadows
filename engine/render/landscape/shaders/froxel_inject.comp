#version 460 core
#include "common.glsl"
#include "sky.glsl"

// Froxel fog, pass 1 (docs/VOLUMETRIC.md V4/H4): one thread per frustum
// voxel — world position from the camera ray and the exponential slice
// depth, density from the height fog (+ the uniform interior dust,
// uFogSunInfo.w), lighting = sun x phase x visibility (CSM + clouds)
// + the GI field's ambient (giAir) + the LOCAL LIGHTS (spot cones and
// window projectors shape the dust indoors). Writes
// (source x density, density) for the integration pass.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 1) uniform sampler2DArrayShadow uShadowMap;
#include "clouds.glsl"
#include "gi.glsl"

layout(std140, binding = 5) uniform LightsUbo {
    vec4 uLightCount;
    vec4 uLightPositionRadius[24];
    vec4 uLightColorIntensity[24];
    vec4 uLightDirectionAngle[24]; // xyz dir, w cos(half angle);
                                   // -2 = point, -3 = window projector
    vec4 uLightWindowInfo[24];     // window half extents (xy)
};

// Window-projector clip for the DUST (docs/LIGHTING.md §3) — same math
// as locallights.glsl: the frame's rectangle extruded along the sun.
float windowBeam(vec3 p, vec3 anchor, vec3 nrm, vec2 halfExtents) {
    vec3 beam = -uSunDirection.xyz;
    float denom = dot(beam, nrm);
    float gate = smoothstep(0.15, 0.40, denom);
    if (gate <= 0.001) {
        return 0.0;
    }
    float s = dot(p - anchor, nrm) / max(denom, 0.15);
    if (s < 0.0) {
        return 0.0;
    }
    vec3 local = (p - beam * s) - anchor;
    vec3 upw = abs(nrm.y) > 0.95 ? vec3(1.0, 0.0, 0.0)
                                 : vec3(0.0, 1.0, 0.0);
    vec3 rightw = normalize(cross(upw, nrm));
    float u = dot(local, rightw);
    float v = dot(local, cross(nrm, rightw));
    const float kEdge = 0.06;
    return gate *
           smoothstep(0.0, kEdge, halfExtents.x - abs(u)) *
           smoothstep(0.0, kEdge, halfExtents.y - abs(v));
}

layout(binding = 6) uniform sampler2DShadow uKeyShadow;
layout(binding = 12, rgba16f) uniform writeonly image3D uFroxelScatter;
// Temporal accumulation (docs/VOLUMETRIC.md V4): last frame's scatter
// volume (the ping-pong twin) + the reprojection constants.
layout(binding = 7) uniform sampler3D uFroxelHistory;
layout(std140, binding = 9) uniform FroxelTemporalUbo {
    mat4 uPrevViewProj;
    vec4 uPrevCamera;   // xyz previous camera, w previous reach (>= 2)
    vec4 uTemporalInfo; // x blend alpha (1 = history invalid), y frame,
                        // z dust wisp amount (0 = uniform dust)
};

float hashCorner(ivec3 q) {
    uint h = uint(q.x) * 73856093u ^ uint(q.y) * 19349663u ^
             uint(q.z) * 83492791u;
    h = (h ^ (h >> 16)) * 0x45d9f3bu;
    h = h ^ (h >> 16);
    return float(h & 0xFFFFFFu) / 16777216.0;
}

// Trilinear value noise — the dust wisp mask. World-anchored and slowly
// drifting: SPARSE dust (empty air between floating sheets) instead of
// a uniform noisy medium.
float valueNoise(vec3 q) {
    ivec3 i = ivec3(floor(q));
    vec3 f = fract(q);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = hashCorner(i);
    float n100 = hashCorner(i + ivec3(1, 0, 0));
    float n010 = hashCorner(i + ivec3(0, 1, 0));
    float n110 = hashCorner(i + ivec3(1, 1, 0));
    float n001 = hashCorner(i + ivec3(0, 0, 1));
    float n101 = hashCorner(i + ivec3(1, 0, 1));
    float n011 = hashCorner(i + ivec3(0, 1, 1));
    float n111 = hashCorner(i + ivec3(1, 1, 1));
    return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
               mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}

// Slice s in [0, depth) -> view distance, exponential (dense near).
float sliceDepth(float s, float slices) {
    const float kNear = 1.0;
    float far = max(uFogSunInfo.z, kNear + 1.0);
    return kNear * pow(far / kNear, s / slices);
}

float froxelShadow(vec3 p) {
    if (uShadowInfo.w <= 0.0) {
        return 1.0;
    }
    float d = distance(p, uCameraPos.xyz);
    if (d >= uCascadeSplits.z) {
        return 1.0;
    }
    int cascade = d < uCascadeSplits.x ? 0 : d < uCascadeSplits.y ? 1 : 2;
    vec4 lightClip = uSunViewProj[cascade] * vec4(p, 1.0);
    vec3 proj = lightClip.xyz / lightClip.w;
    proj.xy = proj.xy * 0.5 + 0.5;
    if (proj.z >= 1.0 || any(lessThan(proj.xy, vec2(0.0))) ||
        any(greaterThan(proj.xy, vec2(1.0)))) {
        return 1.0;
    }
    return texture(uShadowMap, vec4(proj.xy, float(cascade), proj.z));
}

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    ivec3 dims = imageSize(uFroxelScatter);
    if (any(greaterThanEqual(cell, dims))) {
        return;
    }
    // The froxel's camera ray, through the cell center.
    vec2 uv = (vec2(cell.xy) + 0.5) / vec2(dims.xy);
    vec4 nearW = uInvViewProj * vec4(uv * 2.0 - 1.0, 0.1, 1.0);
    vec4 farW = uInvViewProj * vec4(uv * 2.0 - 1.0, 0.9, 1.0);
    vec3 dir = normalize(farW.xyz / farW.w - nearW.xyz / nearW.w);

    // Depth jitter: an integer hash of (cell, frame) — WHITE in time and
    // space, which is what the temporal EMA needs to converge (iid
    // samples per froxel). A phase-rolled spatial pattern (IGN + golden
    // offset) is NOT decorrelation: the same pattern translates at
    // constant velocity and the EMA can only slow the marching bands,
    // never erase them.
    uint h = uint(cell.x) * 73856093u ^ uint(cell.y) * 19349663u ^
             uint(cell.z) * 83492791u ^
             uint(uTemporalInfo.y + 0.5) * 2654435761u;
    h = (h ^ (h >> 16)) * 0x45d9f3bu;
    h = (h ^ (h >> 16)) * 0x45d9f3bu;
    float jitter = float((h >> 8) & 0xFFFFFFu) / 16777216.0;
    float d = sliceDepth(float(cell.z) + jitter, float(dims.z));
    vec3 p = uCameraPos.xyz + dir * d;

    // Density: the height fog past its start distance + the uniform dust
    // (interiors — the composer routes it through uFogSunInfo.w).
    float lowBoost = exp(-max(p.y - uTerrainInfo.x, 0.0) * uFogInfo.y);
    float heightFog = uFogInfo.x * (1.0 + lowBoost * uFogInfo.z) *
                      smoothstep(uFogInfo.w * 0.8, uFogInfo.w, d);
    float dust = uFogSunInfo.w;
    if (dust > 0.0 && uTemporalInfo.z > 0.001) {
        // Two octaves, drifting like slow air currents; the smoothstep
        // threshold empties most of the volume. x1.8 roughly restores
        // the mean so the Interior dust slider keeps its meaning.
        vec3 drift = vec3(uTime.x * 0.16, uTime.x * 0.05, 0.0);
        float n = valueNoise(p * 0.8 + drift) * 0.65 +
                  valueNoise(p * 2.7 + drift * 1.7) * 0.35;
        float wisp = smoothstep(0.38, 0.75, n) * 1.8;
        dust *= mix(1.0, wisp, uTemporalInfo.z);
    }
    float density = heightFog + dust;
    if (density <= 1e-6) {
        imageStore(uFroxelScatter, cell, vec4(0.0));
        return;
    }

    // Sun: phase lobe (V1 knobs, isotropic floor for side-on curtains)
    // x per-froxel visibility. Ambient: the GI field inside its volume,
    // the sky gradient beyond, dimmed in shadowed air.
    float vis = cloudShadowFactor(p) * froxelShadow(p);
    float mu = dot(dir, uSunDirection.xyz);
    float lobe = pow(clamp(mu * 0.5 + 0.5, 0.0, 1.0), uFogSunInfo.y);
    float phase = 0.35 + 0.65 * lobe;
    vec3 haze = giAir(p, skyGradient(dir));
    // DUST wants dark air around bright beams: the ambient term applies
    // fully to the outdoor height fog but only faintly to the uniform
    // dust — beams are drawn by CONTRAST. hand-tuned dust factor.
    float dustFrac = dust / density;
    vec3 source = haze * (mix(0.45, 1.0, vis) * mix(1.0, 0.15, dustFrac)) +
                  uSunColor.rgb * (phase * uFogSunInfo.x * uTime.z * vis);

    // Local lights: windowed quadratic falloff + spot cone. Isotropic
    // phase — a lamp glows in the dust all around itself.
    int count = int(uLightCount.x + 0.5);
    for (int i = 0; i < count; ++i) {
        vec3 toLight = uLightPositionRadius[i].xyz - p;
        float dist = length(toLight);
        float radius = uLightPositionRadius[i].w;
        if (dist >= radius) {
            continue;
        }
        float t = 1.0 - dist / radius;
        // The quadratic damping is what CONCENTRATES the glow near the
        // source so beams read as beams — visibility is the medium's job
        // (the Interior dust density), not the light's.
        float atten = t * t / (1.0 + dist * dist * 0.35);
        vec4 spot = uLightDirectionAngle[i];
        if (spot.w < -2.5) {
            // Window projector: the frame shapes the dust column.
            atten *= windowBeam(p, uLightPositionRadius[i].xyz,
                                spot.xyz, uLightWindowInfo[i].xy);
        } else if (spot.w > -1.5) {
            // Edge width RELATIVE to the remaining cos range: a fixed
            // +0.08 overflowed past 1.0 for tight cones (28° spots) and
            // crushed the beam to ~30% even dead on axis.
            atten *= smoothstep(spot.w, mix(spot.w, 1.0, 0.5),
                                dot(-normalize(toLight), spot.xyz));
        }
        // The key light's shadow map clips this light's DUST by real
        // geometry — the window aperture shapes the beam (matched by
        // position, the locallights.glsl contract).
        if (uKeyShadowInfo.w > 0.5 &&
            distance(uLightPositionRadius[i].xyz, uKeyShadowInfo.xyz) <
                0.05) {
            vec4 lc = uKeyShadowViewProj * vec4(p, 1.0);
            if (lc.w > 0.0) {
                vec3 lproj = lc.xyz / lc.w;
                lproj.xy = lproj.xy * 0.5 + 0.5;
                if (lproj.z < 1.0 &&
                    all(greaterThan(lproj.xy, vec2(0.0))) &&
                    all(lessThan(lproj.xy, vec2(1.0)))) {
                    atten *= texture(uKeyShadow,
                                     vec3(lproj.xy, lproj.z - 0.0022));
                }
            }
        }
        source += uLightColorIntensity[i].rgb * (atten * 0.55);
    }

    // Exponential temporal accumulation: reproject this froxel's world
    // point into LAST frame's volume (previous view-proj for the screen
    // uv, previous camera distance for the log slice — the mapping of
    // sliceDepth inverted) and blend. History outside the previous
    // frustum, or invalidated by the CPU (teleport, reach change, first
    // frame), falls back to the current sample alone.
    vec4 result = vec4(source * density, density);
    if (uTemporalInfo.x < 0.999) {
        vec4 prevClip = uPrevViewProj * vec4(p, 1.0);
        if (prevClip.w > 0.0) {
            vec2 prevUv = prevClip.xy / prevClip.w * 0.5 + 0.5;
            float slice = log(max(distance(p, uPrevCamera.xyz), 1.0)) /
                          log(uPrevCamera.w);
            if (all(greaterThanEqual(prevUv, vec2(0.0))) &&
                all(lessThanEqual(prevUv, vec2(1.0))) && slice <= 1.0) {
                result = mix(texture(uFroxelHistory,
                                     vec3(prevUv, slice)),
                             result, uTemporalInfo.x);
            }
        }
    }
    imageStore(uFroxelScatter, cell, result);
}
