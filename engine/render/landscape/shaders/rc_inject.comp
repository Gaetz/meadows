#version 460 core
#include "common.glsl"

// Radiance cascades injection (docs/RENDERING.md) — voxel clipmap
// injection: one thread per voxel, both clips in one dispatch (z stacks
// clip 0 then clip 1). Terrain surface comes from the worker-baked
// height/albedo tile (patch/sculpt-aware — terrain::height ran on the
// CPU); sun visibility from the CSM (the volumetric-march pattern) times
// the terrain light map's far-field sun. Output: rgb = direct radiance
// leaving the voxel, a = occupancy (solid below ground blocks intervals).

layout(binding = 1) uniform sampler2DArrayShadow uShadowMap;
#include "shadow.glsl"
#include "terrainlight.glsl"
#include "rc_common.glsl"

layout(std140, binding = 2) uniform RcUbo {
    vec4 uRcClipInfo[2]; // xyz = min-corner origin, w = voxel size
    vec4 uRcTileInfo;    // xy = tile center XZ, z = 1/span,
                         // w = CLIP resolution (voxels per axis)
    vec4 uRcMisc;        // x = debug clip index, y = sky factor,
                         // z = box count, w = light count
    vec4 uRcLightPosRadius[24]; // local lights (xyz, w = radius)
    vec4 uRcLightColor[24];     // rgb premultiplied by intensity
    vec4 uRcMisc3; // x = light emitter boost (the blob's radiance scale),
                   // y = bounce feedback (0 = single bounce)
    vec4 uRcPrevGrid; // xyz = LAST inject's fine-grid origin,
                      // w = its probe spacing (uRcPrev's frame of ref)
};

// Props/kits/NPCs as AABBs — two vec4 bounds + albedo/emissive.
layout(std430, binding = 3) readonly buffer RcBoxes {
    vec4 uRcBoxData[]; // triples: min, max, albedo(rgb)+emissive(a)
};

layout(binding = 0, rgba16f) uniform writeonly image3D uClipFine;
layout(binding = 1, rgba16f) uniform writeonly image3D uClipCoarse;
layout(binding = 8) uniform sampler2D uRcHeight;
layout(binding = 9) uniform sampler2D uRcAlbedo;
layout(binding = 10) uniform sampler3D uRcPrev; // LAST merged cascade 0
// Analytic surface normal xz (baked): smooth along slopes — deriving it
// from the bilinear height FACETED per texel and banded the bounce.
layout(binding = 12) uniform sampler2D uRcNormal;

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

float tileHeight(vec2 worldXz) {
    vec2 uv = (worldXz - uRcTileInfo.xy) * uRcTileInfo.z + 0.5;
    return texture(uRcHeight, uv).r;
}

// Multi-bounce: LAST frame's merged GI arriving at this surface —
// the same 8-slab cosine gather as gi.glsl, over uRcPrev's grid.
vec3 prevBounce(vec3 world, vec3 n) {
    float res = uRcTileInfo.w;
    float spacing = uRcPrevGrid.w;
    if (spacing <= 0.0) {
        return vec3(0.0);
    }
    float span = res * spacing;
    vec3 uvw = (world + n * spacing - uRcPrevGrid.xyz) / span;
    if (any(lessThan(uvw, vec3(0.01))) ||
        any(greaterThan(uvw, vec3(0.99)))) {
        return vec3(0.0);
    }
    float zProbe = clamp(uvw.z * res, 0.5, res - 0.5);
    vec2 uvXY = clamp(uvw.xy, vec2(0.5 / res), vec2(1.0 - 0.5 / res));
    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (int d = 0; d < 8; ++d) {
        vec3 dir = rcOctDecode(vec2(d % 4, d / 4), vec2(4.0, 2.0));
        float w = max(dot(n, dir), 0.0) + 0.05;
        float z = (zProbe + float(d) * res) / (res * 8.0);
        sum += w * texture(uRcPrev, vec3(uvXY, z)).rgb;
        weightSum += w;
    }
    return sum / max(weightSum, 1e-3);
}

void main() {
    const int res = int(uRcTileInfo.w);
    const int clip = int(gl_GlobalInvocationID.z) / res;
    const ivec3 voxel = ivec3(gl_GlobalInvocationID.x,
                              gl_GlobalInvocationID.y,
                              int(gl_GlobalInvocationID.z) - clip * res);
    if (voxel.x >= res || voxel.y >= res || clip > 1) {
        return;
    }

    const vec4 info = uRcClipInfo[clip];
    const float voxelSize = info.w;
    const vec3 world = info.xyz + (vec3(voxel) + 0.5) * voxelSize;

    // --- Classify the voxel: terrain surface / underground / box ---
    const float h = tileHeight(world.xz);
    const float halfVoxel = voxelSize * 0.5;
    float occupancy = 0.0;
    vec3 albedo = vec3(0.0);
    vec3 normal = vec3(0.0, 1.0, 0.0);
    vec3 emissive = vec3(0.0);

    // Terrain voxels evaluate their LIGHTING at the true surface point
    // (litPos, y = exact tile height), not the voxel center: along a
    // slope the surface voxels form a 0.5 m staircase, and at grazing
    // sun the CSM / light-map terms flip per step — terraced bounce
    // bands following the slope contours. Occlusion stays voxelized.
    vec3 litPos = world;
    if (world.y < h - halfVoxel) {
        occupancy = 1.0; // solid underground: pure occluder (albedo 0)
    } else if (abs(world.y - h) <= halfVoxel + voxelSize * 0.25) {
        // Terrain surface: albedo + ANALYTIC normal from the baked tile.
        occupancy = 1.0;
        vec2 uv = (world.xz - uRcTileInfo.xy) * uRcTileInfo.z + 0.5;
        vec2 nxz = texture(uRcNormal, uv).rg * 2.0 - 1.0;
        normal = normalize(
            vec3(nxz.x, sqrt(max(1.0 - dot(nxz, nxz), 0.04)), nxz.y));
        albedo = texture(uRcAlbedo, uv).rgb;
        litPos = vec3(world.x, h, world.z);
    }

    // Boxes override/add (props, kits, NPCs, canopies — coarse AABB
    // occlusion; boundsMin.w < 1 = semi-transparent, the march filters).
    const int boxCount = int(uRcMisc.z);
    for (int b = 0; b < boxCount; ++b) {
        const vec4 bminO = uRcBoxData[b * 3 + 0];
        const vec3 bmin = bminO.xyz - halfVoxel;
        const vec3 bmax = uRcBoxData[b * 3 + 1].xyz + halfVoxel;
        if (all(greaterThanEqual(world, bmin)) &&
            all(lessThanEqual(world, bmax))) {
            const vec4 boxAlbedo = uRcBoxData[b * 3 + 2];
            occupancy = max(occupancy, bminO.w);
            albedo = boxAlbedo.rgb;
            normal = vec3(0.0, 1.0, 0.0); // stylized: boxes light as tops
            emissive += boxAlbedo.rgb * boxAlbedo.a;
        }
    }

    // The lights THEMSELVES enter the field as small emissive blobs
    // (surface splats only light SURFACES and a flat floor cannot see
    // itself — without this, interiors band while open terrain does not,
    // since walls/ceilings carried the light indoors). A finite-size emitter is
    // also what the penumbra hypothesis wants; the 1/d² falloff emerges
    // from the source's solid angle across the cascades.
    {
        const int lightCount = int(uRcMisc.w);
        const float blob = voxelSize * 1.5;
        for (int l = 0; l < lightCount; ++l) {
            const float dist =
                distance(uRcLightPosRadius[l].xyz, world);
            if (dist < blob) {
                const float soft = 1.0 - dist / blob;
                occupancy = max(occupancy, 0.5 * soft);
                emissive += uRcLightColor[l].rgb * (uRcMisc3.x * soft);
            }
        }
    }

    // --- Light the occupied voxel ---------------------------------------
    vec4 result = vec4(0.0);
    if (occupancy > 0.0) {
        vec3 radiance = emissive;
        if (dot(albedo, albedo) > 0.0) {
            // Sun: CSM (offset off the surface against acne) x the terrain
            // light map's long-range shadow; sky: ambient x openness.
            // (Cloud shadows skipped — too soft to matter in indirect.)
            const float ndl = max(dot(normal, uSunDirection.xyz), 0.0);
            const float sun = shadowFactor(litPos + normal * voxelSize,
                                           normal);
            const vec2 tl = terrainLightFactors(litPos);
            radiance += albedo * (uSunColor.rgb * (ndl * sun * tl.x) +
                                  uAmbientColor.rgb * (uRcMisc.y * tl.y));
            // Last frame's GI bounces once more off this surface.
            if (uRcMisc3.y > 0.0) {
                radiance += albedo * prevBounce(litPos, normal) *
                            uRcMisc3.y;
            }
            // Local lights (torches, spells) — SAME windowed inverse-
            // square as locallights.glsl (a fatter quadratic splat makes
            // the bounce read too strong against the direct light).
            const int lightCount = int(uRcMisc.w);
            for (int l = 0; l < lightCount; ++l) {
                const vec3 toLight = uRcLightPosRadius[l].xyz - litPos;
                const float dist = length(toLight);
                const float radius = uRcLightPosRadius[l].w;
                if (dist < radius) {
                    float window =
                        clamp(1.0 - pow(dist / radius, 4.0), 0.0, 1.0);
                    float att = (window * window) / (dist * dist + 1.0);
                    radiance += albedo * uRcLightColor[l].rgb * att;
                }
            }
        }
        result = vec4(radiance, occupancy);
    }

    if (clip == 0) {
        imageStore(uClipFine, voxel, result);
    } else {
        imageStore(uClipCoarse, voxel, result);
    }
}
