<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="menus.rcss"/>
</head>
<body>
	<div id="menu" class="panel" data-model="menu">
		<div class="title" data-loc="ui.wait.title">Wait</div>
		<div class="menu-buttons">
			<button data-event-click="menuAction('wait1')" data-loc="ui.wait.wait1">Wait 1 hour</button>
			<button data-event-click="menuAction('wait4')" data-loc="ui.wait.wait4">Wait 4 hours</button>
			<button data-event-click="menuAction('wait8')" data-loc="ui.wait.wait8">Wait 8 hours</button>
			<button data-event-click="menuAction('cancel')" data-loc="ui.wait.cancel">Cancel</button>
		</div>
		<div class="muted">{{ clockLine }} &mdash; <span data-loc="ui.wait.hint">waiting passes game time without the recovery of a bed.</span></div>
	</div>
</body>
</rml>
