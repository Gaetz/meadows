<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="menus.rcss"/>
	<link type="text/rcss" href="saves.rcss"/>
</head>
<body>
	<div id="menu" class="panel" data-model="saves">
		<div class="title">Load game</div>
		<div id="slots">
			<div class="slot" data-for="slot : rows" data-event-click="loadSlot(slot.id)">
				<span class="slot-name">{{ slot.c0 }}</span>
				<span class="slot-date muted">{{ slot.c1 }}</span>
			</div>
		</div>
		<div class="muted" data-if="empty">No saves yet — F5 quicksaves.</div>
		<div class="menu-buttons">
			<button data-event-click="loadCancel()">Back</button>
		</div>
	</div>
</body>
</rml>
