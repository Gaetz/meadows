<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="journal.rcss"/>
</head>
<body>
	<!-- C9.5: realigned on the data-loc mechanism — English authoring text
	     inline, the FR pack patches the LocStringForm records. -->
	<div id="menu" class="panel" data-model="journal">
		<div class="title" data-loc="ui.journal.title">Journal</div>
		<div id="quests">
			<div class="entry" data-for="row : rows" data-class-done="row.tag == 'done'" data-class-task="row.tag == 'task'">
				<span class="entry-text">{{ row.c0 }}</span>
				<span class="entry-status muted">{{ row.c1 }}</span>
				<span class="entry-progress accent">{{ row.c2 }}</span>
			</div>
		</div>
		<div class="muted" data-if="empty" data-loc="ui.journal.empty">No quests yet.</div>
		<div class="menu-buttons">
			<button data-event-click="journalClose()" data-loc="ui.journal.close">Close</button>
		</div>
	</div>
</body>
</rml>
