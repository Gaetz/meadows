<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="inventory.rcss"/>
</head>
<body>
	<!-- data-model on a wrapper div, NOT on body: body attributes apply
	     after children parse, which silently skips data-for.
	     C9.5: static labels carry data-loc="key" — the inner text is the
	     English authoring fallback the localizer replaces on load. -->
	<div id="window" class="panel" data-model="inventory">
		<div class="title" data-loc="ui.inventory.title">Inventory</div>
		<div id="tabs">
			<!-- C9.3: nav anchors — the rows' left/right exits (theme.rcss
			     #items .row) point at these ids. -->
			<div class="tab" id="tab-all" data-event-click="tab('all')" data-loc="ui.inventory.tab.all">All</div>
			<div class="tab" data-event-click="tab('weapons')" data-loc="ui.inventory.tab.weapons">Weapons</div>
			<div class="tab" data-event-click="tab('armor')" data-loc="ui.inventory.tab.armor">Armor</div>
			<div class="tab" data-event-click="tab('consumables')" data-loc="ui.inventory.tab.consumables">Consumables</div>
			<div class="tab" data-event-click="tab('misc')" data-loc="ui.inventory.tab.misc">Misc</div>
			<input type="text" class="text" id="search" data-value="search"/>
		</div>
		<div class="tablehead">
			<div class="col name" data-event-click="sortCol('name')" data-loc="ui.cols.name">Name</div>
			<div class="col num" data-event-click="sortCol('weight')" data-loc="ui.cols.weight">Weight</div>
			<div class="col num" data-event-click="sortCol('value')" data-loc="ui.cols.value">Value</div>
			<div class="col num" data-event-click="sortCol('power')" data-loc="ui.cols.power">Power</div>
		</div>
		<div id="items">
			<div class="row" data-for="row : rows" data-class-selected="row.selected" data-class-equipped="row.tag == 'equipped'" data-event-click="pick(row.id)">
				<div class="col name">{{ row.c0 }}</div>
				<div class="col num">{{ row.c1 }}</div>
				<div class="col num">{{ row.c2 }}</div>
				<div class="col num">{{ row.c3 }}</div>
			</div>
		</div>
		<div id="detail" data-if="hasSelection">
			<div id="detailname" class="accent">{{ detailName }}</div>
			<div id="detailinfo" class="muted">{{ detailInfo }}</div>
			<button id="btn-equip" data-if="!selUsable" data-event-click="equipAction()">{{ equipLabel }}</button>
			<button id="btn-use" data-if="selUsable" data-event-click="useAction()" data-loc="ui.inventory.use">Use</button>
		</div>
		<div id="footer" class="muted">{{ weightText }} &nbsp;&mdash;&nbsp; <span data-loc="ui.inventory.close">[I] close</span></div>
	</div>
</body>
</rml>
