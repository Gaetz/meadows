/* Norden-inspired shared theme (chantier 4): modern, restrained, muted
   near-monochrome panels with one warm accent — no parchment. A mod
   overrides this whole file by shiping ui/theme.rcss (path overlay). */

body {
	width: 100%;
	height: 100%;
	font-family: "JetBrains Mono";
	font-size: 16dp;
	color: #e6e3dc;
}

.panel {
	background-color: #14161acc;
	border: 1dp #3c4046;
	border-radius: 5dp;
	padding: 14dp;
}

.title {
	font-size: 21dp;
	color: #f0ede4;
	letter-spacing: 2dp;
	border-bottom: 1dp #3c4046;
	padding-bottom: 6dp;
	margin-bottom: 10dp;
}

.muted {
	color: #8a8f96;
}

.accent {
	color: #d9b96c;
}

button, .button {
	display: inline-block;
	padding: 6dp 16dp;
	margin: 3dp;
	background-color: #1e2126e6;
	border: 1dp #4a4f56;
	border-radius: 4dp;
	color: #e6e3dc;
	cursor: pointer;
	text-align: center;
}

button:hover, .button:hover {
	border-color: #f0ede4;
	color: #f5f2e9;
}

button.disabled, .button.disabled {
	color: #5b5f66;
	border-color: #2c2f34;
}

input.text {
	background-color: #101216e6;
	border: 1dp #4a4f56;
	border-radius: 4dp;
	padding: 4dp 8dp;
	color: #e6e3dc;
	cursor: text;
}

input.text:focus {
	border-color: #f0ede4;
}

/* C9.3 — gamepad / keyboard navigation. Everything clickable becomes a
   focus target (tab-index) and a spatial-navigation source (nav): on an
   arrow keydown RmlUi walks from the focused element to the nearest
   `tab-index: auto` element in that direction, and Enter/Space click
   it. The d-pad and left stick pulse the same arrow keys. */

[data-event-click], button, .button {
	tab-index: auto;
	nav: auto;
}

input.text {
	nav: auto; /* already focusable (form control); Up/Down leave it */
}

/* Spatial search stops at scroll containers, so lists need explicit
   exits (ids live in the documents): inventory rows go left to the
   tabs and right to the detail buttons, save slots right to Back,
   loot rows right to Take all. */
#items .row {
	nav-left: #tab-all;
	nav-right: #btn-equip;
}

#slots .slot {
	nav-right: #btn-back;
}

#lootlist .row {
	nav-right: #btn-takeall;
}

/* The focus ring — keyboard/pad focus only (:focus-visible; a mouse
   click focuses without it), mirroring each element's hover look. */
button:focus-visible, .button:focus-visible {
	border-color: #f0ede4;
	color: #f5f2e9;
}

.tab:focus-visible {
	color: #f0ede4;
	border-bottom-color: #f0ede4;
}

.tablehead .col:focus-visible {
	color: #f0ede4;
}

.row:focus-visible {
	background-color: #23262ce0;
	border-left: 2dp #f0ede4;
}

.option:focus-visible {
	color: #f5f2e9;
	background-color: #23262ce0;
}

.slot:focus-visible {
	background-color: #23262ce0;
	border-left: 2dp #f0ede4;
}

input.text:focus-visible {
	border-color: #f0ede4;
}

scrollbarvertical {
	width: 8dp;
}

scrollbarvertical slidertrack {
	background-color: #1a1d21;
}

scrollbarvertical sliderbar {
	background-color: #4a4f56;
	border-radius: 4dp;
}

scrollbarvertical sliderbar:hover {
	background-color: #f0ede4;
}
