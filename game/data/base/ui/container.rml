<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="inventory.rcss"/>
</head>
<body>
	<div id="transfer">
		<div class="panel side" data-model="container">
			<div class="title">{{ title }}</div>
			<div class="tablehead">
				<div class="col name">Name</div>
				<div class="col num">Weight</div>
				<div class="col num">Value</div>
				<div class="col num">Power</div>
			</div>
			<!-- C9.3: lootlist/btn-takeall = the pad's exit out of the
			     scrollable list (theme.rcss #lootlist .row). -->
			<div class="itemlist" id="lootlist">
				<div class="row" data-for="row : rows" data-event-click="pickLoot(row.id)">
					<div class="col name">{{ row.c0 }}</div>
					<div class="col num">{{ row.c1 }}</div>
					<div class="col num">{{ row.c2 }}</div>
					<div class="col num">{{ row.c3 }}</div>
				</div>
			</div>
			<button id="btn-takeall" data-event-click="takeAll()">Take all</button>
		</div>
		<div class="panel side" data-model="inventory">
			<div class="title">You</div>
			<div class="tablehead">
				<div class="col name" data-event-click="sortCol('name')">Name</div>
				<div class="col num" data-event-click="sortCol('weight')">Weight</div>
				<div class="col num" data-event-click="sortCol('value')">Value</div>
				<div class="col num" data-event-click="sortCol('power')">Power</div>
			</div>
			<div class="itemlist">
				<div class="row" data-for="row : rows" data-class-equipped="row.tag == 'equipped'" data-event-click="pick(row.id)">
					<div class="col name">{{ row.c0 }}</div>
					<div class="col num">{{ row.c1 }}</div>
					<div class="col num">{{ row.c2 }}</div>
					<div class="col num">{{ row.c3 }}</div>
				</div>
			</div>
			<div class="muted">{{ weightText }} &nbsp;&mdash;&nbsp; click an item to move it</div>
		</div>
	</div>
</body>
</rml>
