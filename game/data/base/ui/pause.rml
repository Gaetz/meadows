<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="menus.rcss"/>
</head>
<body>
	<div id="menu" class="panel" data-model="menu">
		<div class="title" data-loc="ui.pause.title">Paused</div>
		<div class="menu-buttons">
			<button data-event-click="menuAction('resume')" data-loc="ui.pause.resume">Resume</button>
			<button data-event-click="menuAction('save')" data-loc="ui.pause.save">Save game</button>
			<button data-event-click="menuAction('loadmenu')" data-loc="ui.pause.load">Load game</button>
			<button data-event-click="menuAction('options')" data-loc="ui.pause.options">Options</button>
			<button data-event-click="menuAction('mainmenu')" data-loc="ui.pause.mainmenu">Main menu</button>
			<button data-event-click="menuAction('quit')" data-loc="ui.pause.quit">Quit</button>
		</div>
		<div class="muted">{{ clockLine }}</div>
	</div>
</body>
</rml>
