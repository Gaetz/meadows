<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="menus.rcss"/>
</head>
<body>
	<div id="menu" class="panel" data-model="menu">
		<div class="title">Paused</div>
		<div class="menu-buttons">
			<button data-event-click="menuAction('resume')">Resume</button>
			<button data-event-click="menuAction('save')">Save game</button>
			<button data-event-click="menuAction('loadmenu')">Load game</button>
			<button data-event-click="menuAction('mainmenu')">Main menu</button>
			<button data-event-click="menuAction('quit')">Quit</button>
		</div>
		<div class="muted">{{ clockLine }}</div>
	</div>
</body>
</rml>
