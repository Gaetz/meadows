<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="menus.rcss"/>
</head>
<body>
	<div id="gametitle" data-loc="ui.mainmenu.title">True Adventurer</div>
	<div id="menu" class="panel main" data-model="menu">
		<div class="menu-buttons">
			<button data-event-click="menuAction('play-sandbox')" data-loc="ui.mainmenu.sandbox">Sandbox mode</button>
			<button data-event-click="menuAction('play-story')" data-loc="ui.mainmenu.story">Story mode</button>
			<button data-event-click="menuAction('loadmenu')" data-loc="ui.mainmenu.load">Load game</button>
			<button data-event-click="menuAction('options')" data-loc="ui.mainmenu.options">Options</button>
			<button data-event-click="menuAction('quit')" data-loc="ui.mainmenu.quit">Quit</button>
		</div>
	</div>
</body>
</rml>
