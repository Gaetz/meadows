/* Menu screens (chantier 4 B6): pause, main menu, wait, workstation. */

#menu {
	width: 340dp;
	margin: auto;
	/* dp, not %: percentage margins resolve against width (or not at
	   all) in RmlUi — the menu was gluing itself to the top edge. */
	margin-top: 170dp;
	text-align: center;
}

/* The game title on the TITLE SCREEN, centered near the top — the
   startup loading gate draws the same title at the same spot, so the
   fade hands over seamlessly. */
#gametitle {
	position: absolute;
	top: 64dp;
	left: 0;
	width: 100%;
	text-align: center;
	font-size: 42dp;
	color: #f0ede4;
	letter-spacing: 4dp;
}

/* Main-menu variant: the button block centers on the SCREEN (the title
   lives above it); classic absolute centering — top% resolves against
   height, the negative margin is half the 340dp width. */
#menu.main {
	position: absolute;
	top: 42%;
	left: 50%;
	margin: 0;
	margin-left: -170dp;
}

/* The startup loading shroud (loading.rml): fullscreen black over the
   scene, carrying the SAME #gametitle as the main menu beneath — the
   fade is a title crossfade. The bar is the shared overlay-bar look
   (game/ui/OverlayBar.hpp draws the ImGui twin for dev scenes). */
#shroud {
	position: absolute;
	top: 0dp;
	left: 0dp;
	width: 100%;
	height: 100%;
	background-color: #000000;
}

#loadwrap {
	position: absolute;
	top: 50%;
	left: 33%;
	width: 34%;
}

#loadbar {
	position: relative;
	display: block;
	height: 8dp;
	background-color: #ffffff1f;
	border-radius: 4dp;
}

#loadfill {
	position: absolute;
	top: 0dp;
	left: 0dp;
	height: 100%;
	border-radius: 4dp;
	background-color: #d9e5f2d9;
}

#loadtext {
	margin-top: 10dp;
	width: 100%;
	text-align: center;
	font-size: 14dp;
	color: #f0ede4cc;
}

.menu-buttons {
	margin: 10dp 0;
}

.menu-buttons button {
	display: block;
	width: 220dp;
	margin: 6dp auto;
}

p {
	line-height: 1.4em;
	margin: 8dp 0;
	text-align: left;
}
