/* Menu screens (chantier 4 B6): pause, main menu, wait, workstation. */

#menu {
	width: 340dp;
	margin: auto;
	/* dp, not %: percentage margins resolve against width (or not at
	   all) in RmlUi — the menu was gluing itself to the top edge. */
	margin-top: 170dp;
	text-align: center;
}

.menu-buttons {
	margin: 10dp 0;
}

.menu-buttons button {
	display: block;
	width: 220dp;
	margin: 6dp auto;
}

p {
	line-height: 1.4em;
	margin: 8dp 0;
	text-align: left;
}
