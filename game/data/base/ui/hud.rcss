/* The always-on HUD overlay (chantier 4 B2). Vitals bottom-left, clock
   top-right, prompt/talk centered — SkyHUD-like restraint. */

body {
	pointer-events: none;
}

#hud {
	position: absolute;
	width: 100%;
	height: 100%;
}

#crosshair {
	position: absolute;
	left: 50%;
	top: 50%;
	margin-left: -6dp;
	margin-top: -11dp;
	width: 12dp;
	text-align: center;
	font-size: 15dp;
	color: #e6e3dc99;
}

/* A7+: the bow-draw gauge — bottom center, only while drawing. */
#charge {
	position: absolute;
	left: 50%;
	bottom: 12%;
	margin-left: -80dp;
	width: 160dp;
	height: 7dp;
	background-color: #14161ab0;
	border: 1dp #3c4046;
	border-radius: 2dp;
}

.chargefill {
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
	background-color: #d8c27a;
}

#prompt {
	position: absolute;
	left: 0;
	right: 0;
	top: 62%;
	text-align: center;
	font-size: 18dp;
	color: #f0ede4;
}

#talk {
	position: absolute;
	left: 0;
	right: 0;
	top: 54%;
	text-align: center;
	font-size: 17dp;
	color: #e8d9b0;
}

#clock {
	position: absolute;
	top: 14dp;
	right: 18dp;
	font-size: 17dp;
	color: #c9c5bb;
	letter-spacing: 1dp;
}

/* Vitals (dev design 2026-07-12): the container spans HALF the screen —
   a 1000-max stat fills it entirely; the outer bar width scales with the
   theoretical max (C++ feeds it in %). */
#vitals {
	position: absolute;
	left: 18dp;
	bottom: 16dp;
	width: 50%;
}

/* Explicit heights: the bars' absolute segments don't grow the layout
   (RmlUi), so each .stat block sizes itself — the value now lives
   INSIDE the bar (dev pass), so a stat is just its 16dp bar. */
.stat {
	margin-top: 5dp; /* dev pass: 5px between bars */
	height: 18dp;    /* the 16dp bar + its 1dp borders */
}

.bar {
	position: relative;
	display: block;
	height: 16dp;
	background-color: #14161ab0;
	border: 1dp #3c4046;
	border-radius: 3dp;
}

/* Segments: fill = current; bonus = a LIGHTER fill past the default max
   (resonance up); malus = a DARKER slice over the capacity a resonance
   malus locked away. */
.bar .fill, .bar .bonus, .bar .malus {
	position: absolute;
	top: 0;
	height: 100%;
	border-radius: 2dp;
}
.bar .fill { left: 0; }

.bar.health .fill   { background-color: #a8483f; }
.bar.health .bonus  { background-color: #d98a80; }
.bar.health .malus  { background-color: #55231f; }
.bar.energy .fill   { background-color: #5d8a4e; }
.bar.energy .bonus  { background-color: #94c483; }
.bar.energy .malus  { background-color: #2d4426; }
.bar.essence .fill  { background-color: #4e6e8a; }
.bar.essence .bonus { background-color: #86a9c6; }
.bar.essence .malus { background-color: #263749; }
.bar.posture .fill  { background-color: #b8a15e; }
.bar.posture .bonus { background-color: #e2cf94; }
.bar.posture .malus { background-color: #5c502c; }

/* The value line rides INSIDE its bar, centered. */
.bar .value {
	position: absolute;
	left: 0;
	top: 1dp;
	width: 100%;
	text-align: center;
	font-size: 11dp;
	color: #f0ede4;
}

/* B7: nameplates over hostile/hurt characters (screen-space, C++ feeds
   left/top in pixels). */
.plate {
	position: absolute;
	width: 120dp;
	text-align: center;
}

.pname {
	font-size: 13dp;
	color: #e6e3dc;
}

.plate.hostile .pname {
	color: #d98c7a;
}

/* The two CONSTANT-length bars over characters: health then poise —
   the PROVEN vitals pattern (relative box + absolute fill + explicit
   sizes; the old in-flow fill never rendered). */
.phealth, .pposture {
	position: relative;
	display: block;
	width: 90dp;
	height: 5dp;
	margin-top: 2dp;
	margin-left: 15dp;
	background-color: #14161ab0;
	border: 1dp #3c4046;
}

.pposture {
	height: 4dp;
}

.pfill, .ppfill {
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
}

.pfill {
	background-color: #a8483f;
}

.ppfill {
	background-color: #b8a15e;
}

/* FOLLOWERS É2: the party frame — one block per active follower, top-left
   (the clock holds top-right). Same proven bar pattern as the nameplates. */
#party {
	position: absolute;
	left: 18dp;
	top: 14dp;
}

.member {
	margin-bottom: 6dp;
}

.mname {
	font-size: 13dp;
	color: #e6e3dc;
}

.mhealth {
	position: relative;
	display: block;
	width: 110dp;
	height: 5dp;
	margin-top: 2dp;
	background-color: #14161ab0;
	border: 1dp #3c4046;
}

.mfill {
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
	background-color: #a8483f;
}
